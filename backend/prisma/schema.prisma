generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facultad {
  idFacultad BigInt    @id @default(autoincrement()) @map("id_facultad")
  nombre     String    @unique @db.VarChar(150)
  carreras   Carrera[]

  @@map("facultad")
}

model Carrera {
  idCarrera           BigInt                    @id @default(autoincrement()) @map("id_carrera")
  idFacultad          BigInt                    @map("id_facultad")
  nombre              String                    @db.VarChar(150)
  facultad            Facultad                  @relation(fields: [idFacultad], references: [idFacultad], onDelete: Restrict)
  planesEstudio       PlanEstudio[]
  areasAcademicas     AreaAcademica[]
  usuariosCarrera     UsuarioCarrera[]
  configuracionesArea ConfiguracionSorteoArea[]
  configuracionesCaso ConfiguracionSorteoCaso[]

  @@unique([idFacultad, nombre])
  @@map("carrera")
}

model PlanEstudio {
  idPlanEstudio  BigInt       @id @default(autoincrement()) @map("id_plan_estudio")
  idCarrera      BigInt       @map("id_carrera")
  nombre         String       @db.VarChar(150)
  estadoVigencia String       @default("VIGENTE") @map("estado_vigencia") @db.VarChar(20)
  carrera        Carrera      @relation(fields: [idCarrera], references: [idCarrera], onDelete: Restrict)
  areas          PlanArea[]
  estudiantes    Estudiante[]
  sorteos        Sorteo[]

  @@unique([idCarrera, nombre])
  @@map("plan_estudio")
}

model AreaAcademica {
  idArea               BigInt           @id @default(autoincrement()) @map("id_area")
  idCarrera            BigInt           @map("id_carrera")
  nombre               String           @db.VarChar(150)
  umbralDisponibilidad Int              @default(2) @map("umbral_disponibilidad")
  estado               String           @default("ACTIVO") @db.VarChar(20)
  carrera              Carrera          @relation(fields: [idCarrera], references: [idCarrera], onDelete: Restrict)
  planes               PlanArea[]
  casos                CasoEstudio[]
  sorteosResultado     SorteoArea[]
  sorteosPool          SorteoAreaPool[]

  @@unique([idCarrera, nombre])
  @@map("area_academica")
}

model PlanArea {
  idPlanEstudio BigInt        @map("id_plan_estudio")
  idArea        BigInt        @map("id_area")
  planEstudio   PlanEstudio   @relation(fields: [idPlanEstudio], references: [idPlanEstudio], onDelete: Restrict)
  area          AreaAcademica @relation(fields: [idArea], references: [idArea], onDelete: Restrict)

  @@id([idPlanEstudio, idArea])
  @@map("plan_area")
}

model CasoEstudio {
  idCasoEstudio    BigInt               @id @default(autoincrement()) @map("id_caso_estudio")
  idArea           BigInt               @map("id_area")
  titulo           String               @db.VarChar(250)
  contenido        String
  documentoAdjunto String?              @map("documento_adjunto")
  estado           String               @default("DISPONIBLE") @db.VarChar(30)
  area             AreaAcademica        @relation(fields: [idArea], references: [idArea], onDelete: Restrict)
  defensas         DefensaExamenGrado[] @relation("CasoDefensa")
  sorteosCaso      SorteoCaso[]
  envios           EnvioCasoEstudio[]
  auditorias       RegistroAuditoria[]

  @@map("caso_estudio")
}

model Rol {
  idRol       BigInt    @id @default(autoincrement()) @map("id_rol")
  nombre      String    @unique @db.VarChar(80)
  descripcion String?
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  idUsuario           BigInt              @id @default(autoincrement()) @map("id_usuario")
  idRol               BigInt              @map("id_rol")
  primerNombre        String              @map("primer_nombre") @db.VarChar(80)
  segundoNombre       String?             @map("segundo_nombre") @db.VarChar(80)
  primerApellido      String              @map("primer_apellido") @db.VarChar(80)
  segundoApellido     String?             @map("segundo_apellido") @db.VarChar(80)
  correoInstitucional String              @unique @map("correo_institucional") @db.VarChar(200)
  passwordHash        String              @map("password_hash")
  estado              String              @default("ACTIVO") @db.VarChar(20)
  rol                 Rol                 @relation(fields: [idRol], references: [idRol], onDelete: Restrict)
  carreras            UsuarioCarrera[]
  sorteos             Sorteo[]
  envios              EnvioCasoEstudio[]
  auditorias          RegistroAuditoria[]

  @@map("usuario")
}

model UsuarioCarrera {
  idUsuario BigInt  @map("id_usuario")
  idCarrera BigInt  @map("id_carrera")
  usuario   Usuario @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict)
  carrera   Carrera @relation(fields: [idCarrera], references: [idCarrera], onDelete: Restrict)

  @@id([idUsuario, idCarrera])
  @@map("usuario_carrera")
}

model Estudiante {
  idEstudiante      BigInt               @id @default(autoincrement()) @map("id_estudiante")
  idPlanEstudio     BigInt               @map("id_plan_estudio")
  carnetEstudiantil String               @unique @map("carnet_estudiantil") @db.VarChar(50)
  carnetIdentidad   String               @map("carnet_identidad") @db.VarChar(30)
  nombreCompleto    String               @map("nombre_completo") @db.VarChar(150)
  correo            String               @db.VarChar(200)
  estado            String               @default("ACTIVO") @db.VarChar(20)
  fechaRegistro     DateTime             @default(now()) @map("fecha_registro")
  planEstudio       PlanEstudio          @relation(fields: [idPlanEstudio], references: [idPlanEstudio], onDelete: Restrict)
  procesos          ProcesoExamenGrado[]
  envios            EnvioCasoEstudio[]

  @@index([idPlanEstudio, carnetEstudiantil])
  @@map("estudiante")
}

model ProcesoExamenGrado {
  idProceso     BigInt                 @id @default(autoincrement()) @map("id_proceso")
  idEstudiante  BigInt                 @map("id_estudiante")
  estadoProceso String                 @default("EN_CURSO") @map("estado_proceso") @db.VarChar(30)
  fechaInicio   DateTime               @default(now()) @map("fecha_inicio") @db.Date
  estudiante    Estudiante             @relation(fields: [idEstudiante], references: [idEstudiante], onDelete: Restrict)
  instancias    InstanciaExamenGrado[]
  auditorias    RegistroAuditoria[]

  @@map("proceso_examen_grado")
}

model InstanciaExamenGrado {
  idInstancia     BigInt               @id @default(autoincrement()) @map("id_instancia")
  idProceso       BigInt               @map("id_proceso")
  numeroInstancia Int                  @map("numero_instancia") @db.SmallInt
  estadoInstancia String               @default("PENDIENTE") @map("estado_instancia") @db.VarChar(30)
  resultado       String?              @db.VarChar(20)
  proceso         ProcesoExamenGrado   @relation(fields: [idProceso], references: [idProceso], onDelete: Restrict)
  defensas        DefensaExamenGrado[]
  auditorias      RegistroAuditoria[]

  @@unique([idProceso, numeroInstancia])
  @@map("instancia_examen_grado")
}

model TipoDefensa {
  idTipoDefensa       BigInt                    @id @default(autoincrement()) @map("id_tipo_defensa")
  nombre              String                    @unique @db.VarChar(50)
  descripcion         String?
  defensas            DefensaExamenGrado[]
  configuracionesArea ConfiguracionSorteoArea[]
  configuracionesCaso ConfiguracionSorteoCaso[]

  @@map("tipo_defensa")
}

model DefensaExamenGrado {
  idDefensa        BigInt               @id @default(autoincrement()) @map("id_defensa")
  idInstancia      BigInt               @map("id_instancia")
  idTipoDefensa    BigInt               @map("id_tipo_defensa")
  idCasoUtilizado  BigInt?              @map("id_caso_utilizado")
  fechaDefensa     DateTime             @map("fecha_defensa") @db.Date
  periodoAcademico String               @map("periodo_academico") @db.VarChar(30)
  estadoDefensa    String               @default("PROGRAMADA") @map("estado_defensa") @db.VarChar(30)
  nota             Decimal?             @db.Decimal(6, 2)
  resultado        String?              @db.VarChar(20)
  instancia        InstanciaExamenGrado @relation(fields: [idInstancia], references: [idInstancia], onDelete: Restrict)
  tipoDefensa      TipoDefensa          @relation(fields: [idTipoDefensa], references: [idTipoDefensa], onDelete: Restrict)
  casoUtilizado    CasoEstudio?         @relation("CasoDefensa", fields: [idCasoUtilizado], references: [idCasoEstudio], onDelete: Restrict)
  sorteos          Sorteo[]
  auditorias       RegistroAuditoria[]

  @@unique([idInstancia, idTipoDefensa])
  @@map("defensa_examen_grado")
}

model ConfiguracionSorteoArea {
  idConfigSorteoArea BigInt       @id @default(autoincrement()) @map("id_config_sorteo_area")
  idCarrera          BigInt       @map("id_carrera")
  idTipoDefensa      BigInt       @map("id_tipo_defensa")
  orden              Int          @default(1) @db.SmallInt
  anticipacion       Int?
  unidadAnticipacion String?      @map("unidad_anticipacion") @db.VarChar(30)
  estadoVigencia     String       @default("VIGENTE") @map("estado_vigencia") @db.VarChar(20)
  carrera            Carrera      @relation(fields: [idCarrera], references: [idCarrera], onDelete: Restrict)
  tipoDefensa        TipoDefensa  @relation(fields: [idTipoDefensa], references: [idTipoDefensa], onDelete: Restrict)
  sorteosArea        SorteoArea[]

  @@map("configuracion_sorteo_area")
}

model ConfiguracionSorteoCaso {
  idConfigSorteoCaso BigInt       @id @default(autoincrement()) @map("id_config_sorteo_caso")
  idCarrera          BigInt       @map("id_carrera")
  idTipoDefensa      BigInt       @map("id_tipo_defensa")
  modoObtencionCaso  String       @default("NUEVO_SORTEO") @map("modo_obtencion_caso") @db.VarChar(40)
  orden              Int          @default(2) @db.SmallInt
  anticipacion       Int?
  unidadAnticipacion String?      @map("unidad_anticipacion") @db.VarChar(30)
  plazoResolucion    Int?         @map("plazo_resolucion")
  unidadPlazo        String?      @map("unidad_plazo") @db.VarChar(30)
  estadoVigencia     String       @default("VIGENTE") @map("estado_vigencia") @db.VarChar(20)
  carrera            Carrera      @relation(fields: [idCarrera], references: [idCarrera], onDelete: Restrict)
  tipoDefensa        TipoDefensa  @relation(fields: [idTipoDefensa], references: [idTipoDefensa], onDelete: Restrict)
  sorteosCaso        SorteoCaso[]

  @@map("configuracion_sorteo_caso")
}

model Sorteo {
  idSorteo              BigInt              @id @default(autoincrement()) @map("id_sorteo")
  idDefensa             BigInt              @map("id_defensa")
  idUsuarioEjecutor     BigInt              @map("id_usuario_ejecutor")
  idPlanEstudioContexto BigInt              @map("id_plan_estudio_contexto")
  idSorteoAnterior      BigInt?             @map("id_sorteo_anterior")
  fechaHora             DateTime            @default(now()) @map("fecha_hora")
  fechaDefensaContexto  DateTime            @map("fecha_defensa_contexto") @db.Date
  estadoSorteo          String              @default("ACTIVO") @map("estado_sorteo") @db.VarChar(20)
  estudiantePresente    Boolean             @default(true) @map("estudiante_presente")
  motivoInasistencia    String?             @map("motivo_inasistencia")
  defensa               DefensaExamenGrado  @relation(fields: [idDefensa], references: [idDefensa], onDelete: Restrict)
  usuarioEjecutor       Usuario             @relation(fields: [idUsuarioEjecutor], references: [idUsuario], onDelete: Restrict)
  planEstudioContexto   PlanEstudio         @relation(fields: [idPlanEstudioContexto], references: [idPlanEstudio], onDelete: Restrict)
  sorteoAnterior        Sorteo?             @relation("SorteoAnterior", fields: [idSorteoAnterior], references: [idSorteo], onDelete: Restrict)
  sorteosPosteriores    Sorteo[]            @relation("SorteoAnterior")
  area                  SorteoArea?
  caso                  SorteoCaso?
  auditorias            RegistroAuditoria[]

  @@map("sorteo")
}

model SorteoArea {
  idSorteo           BigInt                  @id @map("id_sorteo")
  idConfigSorteoArea BigInt                  @map("id_config_sorteo_area")
  idAreaResultado    BigInt                  @map("id_area_resultado")
  sorteo             Sorteo                  @relation(fields: [idSorteo], references: [idSorteo], onDelete: Restrict)
  configuracion      ConfiguracionSorteoArea @relation(fields: [idConfigSorteoArea], references: [idConfigSorteoArea], onDelete: Restrict)
  areaResultado      AreaAcademica           @relation(fields: [idAreaResultado], references: [idArea], onDelete: Restrict)
  pool               SorteoAreaPool[]

  @@map("sorteo_area")
}

model SorteoAreaPool {
  idSorteo   BigInt        @map("id_sorteo")
  idArea     BigInt        @map("id_area")
  sorteoArea SorteoArea    @relation(fields: [idSorteo], references: [idSorteo], onDelete: Restrict)
  area       AreaAcademica @relation(fields: [idArea], references: [idArea], onDelete: Restrict)

  @@id([idSorteo, idArea])
  @@map("sorteo_area_pool")
}

model SorteoCaso {
  idSorteo           BigInt                  @id @map("id_sorteo")
  idConfigSorteoCaso BigInt                  @map("id_config_sorteo_caso")
  idCasoSeleccionado BigInt                  @map("id_caso_seleccionado")
  plazoLimiteEntrega DateTime?               @map("plazo_limite_entrega")
  sorteo             Sorteo                  @relation(fields: [idSorteo], references: [idSorteo], onDelete: Restrict)
  configuracion      ConfiguracionSorteoCaso @relation(fields: [idConfigSorteoCaso], references: [idConfigSorteoCaso], onDelete: Restrict)
  casoSeleccionado   CasoEstudio             @relation(fields: [idCasoSeleccionado], references: [idCasoEstudio], onDelete: Restrict)

  @@map("sorteo_caso")
}

model EnvioCasoEstudio {
  idEnvio        BigInt              @id @default(autoincrement()) @map("id_envio")
  idEstudiante   BigInt              @map("id_estudiante")
  idCasoEstudio  BigInt              @map("id_caso_estudio")
  idUsuarioEnvio BigInt              @map("id_usuario_envio")
  correoDestino  String              @map("correo_destino") @db.VarChar(200)
  fechaHoraEnvio DateTime            @default(now()) @map("fecha_hora_envio")
  estadoEnvio    String              @default("PENDIENTE") @map("estado_envio") @db.VarChar(20)
  estudiante     Estudiante          @relation(fields: [idEstudiante], references: [idEstudiante], onDelete: Restrict)
  casoEstudio    CasoEstudio         @relation(fields: [idCasoEstudio], references: [idCasoEstudio], onDelete: Restrict)
  usuarioEnvio   Usuario             @relation(fields: [idUsuarioEnvio], references: [idUsuario], onDelete: Restrict)
  auditorias     RegistroAuditoria[]

  @@map("envio_caso_estudio")
}

model RegistroAuditoria {
  idRegistroAuditoria BigInt                @id @default(autoincrement()) @map("id_registro_auditoria")
  idUsuario           BigInt?               @map("id_usuario")
  idCasoEstudio       BigInt?               @map("id_caso_estudio")
  idSorteo            BigInt?               @map("id_sorteo")
  idProceso           BigInt?               @map("id_proceso")
  idInstancia         BigInt?               @map("id_instancia")
  idDefensa           BigInt?               @map("id_defensa")
  idEnvio             BigInt?               @map("id_envio")
  fechaHora           DateTime              @default(now()) @map("fecha_hora")
  tipoOperacion       String                @map("tipo_operacion") @db.VarChar(60)
  descripcion         String
  motivo              String?
  valorAnterior       Json?                 @map("valor_anterior")
  valorNuevo          Json?                 @map("valor_nuevo")
  usuario             Usuario?              @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull)
  casoEstudio         CasoEstudio?          @relation(fields: [idCasoEstudio], references: [idCasoEstudio], onDelete: SetNull)
  sorteo              Sorteo?               @relation(fields: [idSorteo], references: [idSorteo], onDelete: SetNull)
  proceso             ProcesoExamenGrado?   @relation(fields: [idProceso], references: [idProceso], onDelete: SetNull)
  instancia           InstanciaExamenGrado? @relation(fields: [idInstancia], references: [idInstancia], onDelete: SetNull)
  defensa             DefensaExamenGrado?   @relation(fields: [idDefensa], references: [idDefensa], onDelete: SetNull)
  envio               EnvioCasoEstudio?     @relation(fields: [idEnvio], references: [idEnvio], onDelete: SetNull)

  @@map("registro_auditoria")
}

