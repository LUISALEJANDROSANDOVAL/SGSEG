# ==============================================================================
# SGSEG — Variables de Entorno del Backend (NestJS + Prisma + JWT + Mailer)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# Cadena de conexión para Prisma ORM y cliente pg.
# - Para ejecución local con Docker: puerto 5437
# - Para ejecución interna en Docker Compose: postgres:5432
DATABASE_URL="postgresql://sgseg:sgseg@localhost:5437/sgseg?schema=public"

# ------------------------------------------------------------------------------
# 2. Configuración del Servidor HTTP y Seguridad
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Clave secreta para firma y validación de tokens JWT (8 horas de validez)
# CAMBIAR OBLIGATORIAMENTE EN PRODUCCIÓN por una clave de alta entropía.
JWT_SECRET="sgseg_jwt_super_secret_key_2026"

# Orígenes CORS permitidos (separados por coma). En desarrollo admite localhost por defecto.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:5174"

# Clave maestra para reseteo administrativo de emergencia (POST /api/auth/admin-reset-password)
ADMIN_FALLBACK_SECRET="SGSEG_FALLBACK_2026!"

# ------------------------------------------------------------------------------
# 3. Servidor de Correo Saliente (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# Si se dejan vacíos SMTP_HOST o SMTP_USER, el sistema entra automáticamente en
# modo SIMULACIÓN ESTRUCTURADA: emite los logs en consola y genera actas PDF sin error.
#
# Para Gmail/Google Workspace:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="tu-correo@utepsa.edu.bo"
# SMTP_PASS="contraseña-de-aplicación"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UTEPSA Sorteos de Grado <sorteos@utepsa.edu.bo>"
