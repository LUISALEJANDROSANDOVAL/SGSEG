# ==============================================================================
# SGSEG — Variables de Entorno del Frontend (React 19 + Vite)
# ==============================================================================

# URL Base del Backend / API REST
# - En desarrollo local con Vite: si no se define o se deja vacía, el cliente utiliza
#   el proxy '/api' configurado en vite.config.ts hacia http://localhost:3000.
# - En producción o conexión directa: especificar la URL completa (ej. http://localhost:3000 o https://sgseg-backend.vercel.app).
VITE_API_URL="http://localhost:3000"

# Puerto para Vite preview (npm run preview / npm run start). Opcional (por defecto 4173)
# PORT=4173

# ==============================================================================
# Pinata IPFS (Almacenamiento Descentralizado de Anexos de Casos de Estudio)
# ==============================================================================
# Token JWT de API Pinata (requiere prefijo VITE_ para Vite)
# Obtén tu JWT en: https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=""

# Gateway dedicado o público de Pinata (debe incluir https:// y /ipfs/)
# Ejemplos:
# - Público: "https://gateway.pinata.cloud/ipfs/"
# - Dedicado: "https://tu-subdominio.mypinata.cloud/ipfs/"
VITE_PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"
