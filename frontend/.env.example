# ==============================================================================
# SGSEG — Variables de Entorno del Frontend (React 19 + Vite)
# ==============================================================================

# URL Base del Backend / API REST
# - En desarrollo local con Vite: si no se define o se deja vacía, el cliente utiliza
#   el proxy '/api' configurado en vite.config.ts hacia http://localhost:3000.
# - En producción o conexión directa: especificar la URL completa (ej. http://localhost:3000 o https://api.sgseg.com).
#   El cliente Axios normaliza automáticamente para asegurar que termine en '/api'.
VITE_API_URL="http://localhost:3000"

# Puerto para Vite preview (npm run preview / npm run start). Opcional (por defecto 4173)
# PORT=4173
