# ==============================================================================
# SGSEG — Plantilla Global de Variables de Entorno (Docker Compose & Full Stack)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Contenedor sgseg-postgres)
# ------------------------------------------------------------------------------
POSTGRES_DB=sgseg
POSTGRES_USER=sgseg
POSTGRES_PASSWORD=sgseg

# Cadena de conexión externa (acceso desde host local al puerto mapeado 5437)
DATABASE_URL="postgresql://sgseg:sgseg@localhost:5437/sgseg?schema=public"

# ------------------------------------------------------------------------------
# 2. Backend (NestJS)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET="sgseg_jwt_super_secret_key_2026"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:80,http://localhost"
ADMIN_FALLBACK_SECRET="SGSEG_FALLBACK_2026!"

# Notificaciones por Correo (SMTP / Vacío para modo simulación sin errores)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UTEPSA Sorteos de Grado <sorteos@utepsa.edu.bo>"

# ------------------------------------------------------------------------------
# 3. Frontend & Proxy Nginx
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:3000"
BACKEND_URL="http://backend:3000"
NGINX_LOCAL_RESOLVERS="127.0.0.11 8.8.8.8 1.1.1.1"

# ------------------------------------------------------------------------------
# 4. Pinata IPFS (Almacenamiento de Anexos en Casos de Estudio)
# ------------------------------------------------------------------------------
# Obtén tu JWT en https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=""
VITE_PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"

